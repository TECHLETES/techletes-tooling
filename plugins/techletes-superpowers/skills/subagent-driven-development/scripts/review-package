#!/usr/bin/env bash
# Package every commit in a recorded task/branch range, not just HEAD~1.
# Usage: review-package BASE HEAD [OUTFILE]
# Stdout is only the package path; diagnostics go to stderr.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi
base=$(git rev-parse --verify --end-of-options "${1}^{commit}") || exit 2
head=$(git rev-parse --verify --end-of-options "${2}^{commit}") || exit 2
if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi
mkdir -p "$(dirname "$out")"
out="$(cd "$(dirname "$out")" && pwd)/$(basename "$out")"
tmp=$(mktemp "${out}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  printf '# Review package: %s..%s\n\n' "$base" "$head"
  printf '## Commits\n'
  git --no-pager log --oneline "${base}..${head}"
  printf '\n## Files changed\n'
  git --no-pager diff --no-ext-diff --no-textconv --stat "$base" "$head"
  printf '\n## Diff\n'
  git --no-pager diff --no-ext-diff --no-textconv -U10 "$base" "$head"
} > "$tmp"
mv "$tmp" "$out"
printf '%s\n' "$out"
printf 'wrote %s: %s commit(s)\n' "$out" "$(git rev-list --count "${base}..${head}")" >&2
