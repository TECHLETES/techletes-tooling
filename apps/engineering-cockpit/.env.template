# ========= General settings =========

DOMAIN=localhost
CADDY_ACME_EMAIL=dev@techletes.ai

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# BACKEND_PORT: Port to listen on (default: 8000)
BACKEND_PORT=8000

# SECRET_KEY: Used by FastAPI for cryptographic operations. Change this to a random string in production!
SECRET_KEY=changethis

# WORKERS: Number of Gunicorn workers (default: 4)
WORKERS=4

# Environment: local, staging, production
ENVIRONMENT=local

# LOG_LEVEL: Logging level - debug, info, warning, error (default: debug/info/warning based on env)
LOG_LEVEL=info

# ========= Docker settings =========
# Configure these with your own Docker registry images
DOCKER_IMAGE=backend
PROJECT_NAME="Techletes Engineering Cockpit"
STACK_NAME=engineering-cockpit

# ========= Third-party service settings =========

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@notification.techletes.ai
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Redis (pub/sub for real-time notifications + RQ background jobs)
# Docker Compose sets this to redis://redis:6379 automatically.
# For local development without Docker, start Redis locally: redis-server
REDIS_URL=redis://redis:6379

# ========= Optional Azure Blob backups =========
# Provision one private container per application/environment with
# scripts/setup-azure-backup.sh before starting the Docker Compose stack.
BACKUP_CRON_EXPRESSION=0 3 * * *
BACKUP_RETENTION_DAYS=30
# Do not put this value inside a Compose default expression: Compose can stop
# at the wrong `}` in `{{ .Extension }}` and produce filenames ending in `}`.
BACKUP_FILENAME='my-app-staging-%Y-%m-%dT%H-%M-%S.{{ .Extension }}'
BACKUP_PRUNING_PREFIX=my-app-staging-
AZURE_STORAGE_ACCOUNT_NAME=techletesbackups
AZURE_STORAGE_CONTAINER_NAME=docker-my-app-staging
AZURE_STORAGE_CONNECTION_STRING='azure-container-connection-string'

# ========= Storage settings =========

# File Storage
# STORAGE_BACKEND: "local" (default) stores files on disk; "s3" uses an S3-compatible service
STORAGE_BACKEND=local
# Path used by local storage (mapped to a Docker volume in Compose)
LOCAL_STORAGE_PATH=/app/uploads
# S3 / MinIO settings (only required when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========= Authentication =========

FIRST_SUPERUSER=admin@techletes.ai
FIRST_SUPERUSER_PASSWORD=firstsuperuserpassword

SIGNUP_ENABLED=False

# Microsoft Entra (Azure AD) Authentication
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUPERUSER_ROLE=super_admin

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
