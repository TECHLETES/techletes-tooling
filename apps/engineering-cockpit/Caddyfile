		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

www.staging.{$DOMAIN} {
	redir https://staging.{$DOMAIN}{uri} permanent
}

adminer.staging.{$DOMAIN} {
	reverse_proxy adminer-staging:8080
}
