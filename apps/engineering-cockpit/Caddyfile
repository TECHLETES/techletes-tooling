	handle @api {
		reverse_proxy backend-staging:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

