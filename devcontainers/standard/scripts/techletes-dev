#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: techletes-dev <command> [profile]

Commands:
  doctor                    Check the shared Techletes development toolchain.
  versions                  Print important tool versions.
  git-setup                 Apply Techletes repository-local Git defaults and host identity.
  post-create <profile>     Run the standard workspace bootstrap profile.
                            Profiles: python, full-stack
  post-attach <profile>     Run the standard attach profile.
                            Profiles: python, full-stack
EOF
}

versions() {
  python --version
  uv --version
  node --version
  npm --version
  bun --version
  codex --version
  git --version
  gh --version | head -n 1
  az --version | head -n 1
  docker --version
  docker compose version
  psql --version
  mariadb --version
  redis-cli --version
  op --version
}

doctor() {
  local failed=0
  local commands=(python uv node npm bun codex git gh az docker psql mariadb redis-cli op odbcinst mariadb_config)

  for command_name in "${commands[@]}"; do
    if command -v "${command_name}" >/dev/null 2>&1; then
      printf 'OK   %s\n' "${command_name}"
    else
      printf 'MISS %s\n' "${command_name}" >&2
      failed=1
    fi
  done

  if command -v docker >/dev/null 2>&1; then
    if docker compose version >/dev/null 2>&1; then
      echo 'OK   docker compose'
    else
      echo 'MISS docker compose' >&2
      failed=1
    fi
  fi

  if command -v odbcinst >/dev/null 2>&1; then
    if odbcinst -q -d 2>/dev/null | grep -qi 'mariadb'; then
      echo 'OK   MariaDB ODBC driver'
    else
      echo 'MISS MariaDB ODBC driver' >&2
      failed=1
    fi
  fi

  if [[ ${failed} -ne 0 ]]; then
    echo 'Shared development toolchain check failed.' >&2
    return 1
  fi

  echo 'Shared development toolchain check passed.'
}

git_setup() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo 'git-setup must be run inside a Git worktree.' >&2
    return 1
  fi

  git config --local pull.rebase false
  git config --local branch.autosetuprebase never

  if [[ -f /tmp/host-gitconfig ]]; then
    local host_name host_email
    host_name="$(git config --file /tmp/host-gitconfig --get user.name || true)"
    host_email="$(git config --file /tmp/host-gitconfig --get user.email || true)"

    [[ -z "${host_name}" ]] || git config --local user.name "${host_name}"
    [[ -z "${host_email}" ]] || git config --local user.email "${host_email}"
  fi

  if command -v gh >/dev/null 2>&1; then
    gh auth setup-git >/dev/null 2>&1 || true
  fi

  echo 'Applied Techletes repository-local Git defaults.'
}

post_create_python_dependencies() {
  echo 'Bootstrapping the container workspace with uv...'
  uv sync --locked
  uv tool install graphifyy

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    uv run pre-commit install --install-hooks
  fi
}

post_create_finalize() {
  if ! uv run python -c "import ipykernel" >/dev/null 2>&1; then
    echo 'Notebook execution uses the local Python environment and needs ipykernel available there.'
  fi

  if command -v op >/dev/null 2>&1; then
    echo "1Password CLI detected. Run 'op account list' if you need secret-backed examples."
  fi

  git_setup

  echo 'For Windows contributors, keep this repo inside the WSL filesystem before reopening it in the container for the best bind-mount performance.'
}

post_create() {
  local profile="${1:-}"

  case "${profile}" in
    python)
      post_create_python_dependencies
      post_create_finalize
      ;;
    full-stack)
      sudo install -d -o "$(id -u)" -g "$(id -g)" /app/uploads
      echo 'Ensured /app/uploads exists for local file storage.'

      post_create_python_dependencies

      if [[ ! -d frontend ]]; then
        echo 'Full-stack profile expects a frontend/ directory.' >&2
        return 1
      fi

      echo 'Bootstrapping frontend dependencies with bun...'
      (
        cd frontend
        bun install --frozen-lockfile
      )

      post_create_finalize
      ;;
    *)
      echo "Unknown or missing post-create profile: ${profile:-<none>}" >&2
      echo 'Expected one of: python, full-stack' >&2
      return 2
      ;;
  esac
}

sync_codex_plugin() {
  if [[ "${DEVCONTAINER_CI:-}" == "true" ]]; then
    echo 'Skipping private Codex plugin setup in CI.'
    return 0
  fi

  if ! curl -fsSL https://setup.techletes.ai/setup-codex.sh | bash; then
    echo 'Codex plugin setup failed; continuing without it.' >&2
  fi
}

post_attach() {
  local profile="${1:-}"

  case "${profile}" in
    python)
      sync_codex_plugin
      ;;
    full-stack)
      sync_codex_plugin

      if [[ -f .devcontainer/dev-services.sh ]]; then
        echo 'Restarting local dev services...'
        bash .devcontainer/dev-services.sh restart
      fi
      ;;
    *)
      echo "Unknown or missing post-attach profile: ${profile:-<none>}" >&2
      echo 'Expected one of: python, full-stack' >&2
      return 2
      ;;
  esac
}

case "${1:-doctor}" in
  doctor)
    doctor
    ;;
  versions)
    versions
    ;;
  git-setup)
    git_setup
    ;;
  post-create)
    shift
    post_create "${1:-}"
    ;;
  post-attach)
    shift
    post_attach "${1:-}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
